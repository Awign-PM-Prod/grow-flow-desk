# Frontend (Vite) build-time environment — used by docker compose as build args.
# The browser talks ONLY to the backend gateway; it never calls Supabase directly.

# Public URL of the backend gateway (browser → host:2222).
VITE_API_URL=http://13.204.206.236:2222

# Public Supabase anon key (required by the Supabase JS SDK; not a secret).
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Public URL of the SPA (used for auth redirects / invite links).
VITE_SITE_URL=http://13.204.206.236:1111
