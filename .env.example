# Frontend (Vite) build-time environment — used by docker compose as build args.
# The browser talks ONLY to the HTTPS SPA origin; nginx proxies API paths to the
# backend. Do NOT point VITE_API_URL at http://…:2222 when the site is HTTPS
# (browsers block that as Mixed Content).

VITE_API_URL=https://awigncrm.awignhub.in

# Public Supabase anon key (required by the Supabase JS SDK; not a secret).
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Public URL of the SPA (used for auth redirects / invite links).
VITE_SITE_URL=https://awigncrm.awignhub.in
