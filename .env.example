# Frontend (Vite) build-time environment — used by docker compose as build args.
#
# IMPORTANT: when the site is served over HTTPS, VITE_API_URL must be https://
# (or the same origin). http:// API URLs are blocked by the browser (Mixed Content).
# Nginx in the frontend container proxies /auth/v1, /rest/v1, etc. to the backend.

VITE_API_URL=https://awigncrm.awignhub.in
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
VITE_SITE_URL=https://awigncrm.awignhub.in
