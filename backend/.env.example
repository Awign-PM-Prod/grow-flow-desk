NODE_ENV=production

# Port inside the container (mapped to host 2222 by docker-compose).
PORT=4000

# Comma-separated frontend origins allowed to call this gateway.
CORS_ORIGIN=http://13.204.206.236:1111

# Supabase project the gateway forwards to.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional. NOT used by the transparent gateway (RLS is preserved via the user's
# JWT). Only set this if you later add privileged endpoints that must bypass RLS.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
